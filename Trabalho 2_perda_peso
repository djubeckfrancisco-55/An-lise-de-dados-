# 3. FUNÇÕES AUXILIARES
cohens_d_manual <- function(x, y) {
  n1 <- length(x); n2 <- length(y)
  sp <- sqrt(((n1 - 1) * var(x) + (n2 - 1) * var(y)) / (n1 + n2 - 2))
  (mean(x) - mean(y)) / sp
}
eta_sq_aov <- function(modelo) {
  s    <- summary(modelo)[[1]]
  ss   <- s[["Sum Sq"]]
  eta2 <- ss / sum(ss); names(eta2) <- rownames(s); eta2
}
eta_partial_aov <- function(modelo) {
  s     <- summary(modelo)[[1]]
  ss    <- s[["Sum Sq"]]
  eta_p <- ss / (ss + ss[length(ss)]); names(eta_p) <- rownames(s); eta_p
}


