# 2. FORMATO LARGO + VARIÁVEIS DERIVADAS
dados_largo <- dados %>%
  pivot_wider(
    id_cols      = c(ID, TREAT, AGE, LIVINGSTATUS, SMOKESTATUS, GENDER),
    names_from   = VISIT,
    values_from  = WEIGHT,
    names_prefix = "WEIGHT_"
  ) %>%
  mutate(
    MUDANCA    = WEIGHT_POST - WEIGHT_PRE,
    Perda_Peso = WEIGHT_PRE - WEIGHT_POST,
    Perda_Rel  = (MUDANCA / WEIGHT_PRE) * 100
  )

d <- dados_largo

d$Tratamento <- factor(
  ifelse(d$TREAT == "TREATMENT", "Tratamento", "Controlo"),
  levels = c("Controlo", "Tratamento")
)
d$Fumador <- factor(
